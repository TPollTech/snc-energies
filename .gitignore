# Gradle / build outputs (the jar ships as a GitHub release asset, never committed)
build/
.gradle/

# Local run directories (test worlds, logs, init scripts)
run/

# Python virtual environment for texture generation
.venv-textures/
__pycache__/

# Scratch areas (verification keeps curated logs, hashes and screenshots only)
verification/jarx/
verification/gh-login.log

# Freebuff workspace metadata
.freebuff/

# Dependency jars copied in for integration test runs (never commit jars)
verification/*.jar

# Preview run scratch logs (keep the screenshots)
verification/tractor/preview-server*.log
