{
  "multipart": [
    {
      "apply": {
        "model": "snc_energies:block/steam_pipe"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "snc_energies:block/steam_pipe_down"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "snc_energies:block/steam_pipe_up"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "snc_energies:block/steam_pipe_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "snc_energies:block/steam_pipe_south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "snc_energies:block/steam_pipe_west"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "snc_energies:block/steam_pipe_east"
      }
    }
  ]
}
